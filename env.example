# Reference for every variable the API reads, with its default shown.
#
# Copy to .env and keep only the lines you actually change; commented lines are
# already the default. .env is gitignored and `make api` passes it to uvicorn.
# The name omits the leading dot because .gitignore excludes .env.*

# Which backend answers grounded requests first.
# gemini | openrouter
AI_PROVIDER=gemini
# Optional second backend tried when the primary fails.
AI_FALLBACK_PROVIDER=openrouter
# Or set an explicit ordered list (overrides AI_PROVIDER + AI_FALLBACK_PROVIDER):
# AI_PROVIDERS=gemini,openrouter

# Set to false to disable model output entirely and serve snapshot-derived text.
V2_AI_ENABLED=true

# --- Google Gemini ----------------------------------------------------------
GEMINI_API_KEY=
# gemini-2.5-flash is closed to new keys; 3.8-flash was returning 503 on test.
GEMINI_MODEL=gemini-3.5-flash
# 0 disables Gemini 2.5 thinking tokens. Use -1 to omit the field entirely for
# models that do not accept thinkingConfig.
GEMINI_THINKING_BUDGET=0
# Override only to pin a different API version or route through a proxy.
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# --- OpenRouter (OpenAI-compatible chat API) --------------------------------
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_API_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=https://oncosmart.vercel.app
# OPENROUTER_APP_NAME=EveryDoseMatters

# --- Optional tuning --------------------------------------------------------
# Per-request ceilings in seconds. Defaults differ per provider.
# AI_ASK_TIMEOUT=25
# AI_EXPLAIN_TIMEOUT=30
# How long /api/health may reuse a provider reachability probe, and how long
# that probe itself may take. The probe default differs per provider.
# AI_HEALTH_CACHE_SECONDS=30
# AI_HEALTH_TIMEOUT=1.5

# Model output bounds. Raise the token caps if answers are being truncated;
# the length caps reject over-long model output before it reaches the client.
# AI_ASK_OUTPUT_TOKENS=1024
# AI_EXPLAIN_OUTPUT_TOKENS=2048
# AI_EXPLANATION_FIELD_MAX=1200
# AI_ANSWER_MAX=3000
# AI_LIMITATIONS_MAX=8
# AI_EVIDENCE_ITEMS_MAX=10

# How much of the snapshot is passed to the model as evidence, and how the
# snapshot fallback shapes its own answers.
# AI_EVIDENCE_RECORD_LIMIT=8
# AI_LATEST_RECORD_LIMIT=5
# AI_QUESTION_TERM_LIMIT=8
# AI_QUESTION_MIN_TERM_LENGTH=2

# --- Snapshot and API -------------------------------------------------------
# Path to the imported V2 snapshot. Defaults to apps/api/data/v2.db.
# V2_DATABASE=apps/api/data/v2.db
# NCI oncology drug-name JSON used to seed/sync Atlas.
# Defaults to src/data/nci_oncology_drugs.json (falls back to apps/api/data/...).
# V2_DRUGS_LIST=src/data/nci_oncology_drugs.json
# MONGODB_DRUGS_COLLECTION=oncology_drugs
# MONGODB_DRUGS_META_COLLECTION=oncology_drugs_meta

# Browser origins allowed to call the API, comma separated.
V2_CORS_ORIGINS=http://localhost:5173,https://oncosmart.vercel.app
# Shown when someone opens the API root URL in a browser.
# V2_PUBLIC_APP_URL=https://oncosmart.vercel.app/
# V2_CORS_METHODS=GET,POST,PATCH
# V2_CORS_HEADERS=*
# V2_CORS_EXPOSE_HEADERS=Content-Disposition

# Request limits for /api/alerts and /api/research/ask.
# API_PAGE_SIZE_DEFAULT=20
# API_PAGE_SIZE_MAX=100
# API_SEARCH_MAX_LENGTH=100
# API_COUNTRY_MAX_LENGTH=100
# API_REGULATOR_MAX_LENGTH=200
# API_DATE_MAX_LENGTH=10
# API_QUESTION_MAX_LENGTH=1000
# API_TOP_PRODUCTS_LIMIT=10
# API_REPORT_FILENAME=everydosematters-research-records.csv

# --- Authentication ---------------------------------------------------------
# Required for /api/auth/*. Leave unset to serve the rest of the API without
# authentication endpoints. Never commit real values.
MONGODB_URI=
V2_AUTH_SECRET=
# MONGODB_DATABASE=everydosematters
# MONGODB_USERS_COLLECTION=users
# Collections written by integrations/atlas/export_snapshot.py.
# MONGODB_ALERTS_COLLECTION=alerts
# MONGODB_SNAPSHOTS_COLLECTION=snapshots
# MONGODB_TIMEOUT_MS=5000
# V2_JWT_ALGORITHM=HS256
# V2_TOKEN_TTL_HOURS=8
# V2_DEFAULT_USER_ROLE=researcher
# V2_NAME_MIN_LENGTH=2
# V2_NAME_MAX_LENGTH=120
# V2_PASSWORD_MIN_LENGTH=8
# V2_PASSWORD_MAX_LENGTH=128
# Public account creation. Leave unset (or false) to keep sign-in only.
# V2_SIGNUP_OPEN=false
# Role string stored on admin accounts (Mongo users.role).
# V2_ADMIN_ROLE=admin
# Comma-separated emails treated as admin even if role is still researcher.
# V2_ADMIN_EMAILS=you@example.com

# --- Admin collection tools (GitHub Actions workflow_dispatch) --------------
# PAT or fine-grained token with Actions: write on the scraper repo.
# Never commit real tokens.
GITHUB_ACTIONS_TOKEN=
# owner/name of the repo that hosts weekly_scrape.yaml and drug_database.yaml
GITHUB_ACTIONS_REPO=
# GITHUB_ACTIONS_REF=main
# GITHUB_WORKFLOW_WEEKLY_SCRAPE=weekly_scrape.yaml
# GITHUB_WORKFLOW_DRUG_DATABASE=drug_database.yaml
# Minimum seconds between runs of the same tool from the admin UI.
# V2_COLLECTION_JOB_COOLDOWN_SECONDS=60

# --- Ingest pipeline (src/pipeline) ----------------------------------------
# Paths. Defaults land under src/data next to the existing recalls.db.
# The API review page reads PIPELINE_DB, so keep the same value for make api
# and make pipeline.
# PIPELINE_DATA_DIR=src/data
# PIPELINE_RAW_DIR=src/data/raw
# PIPELINE_DB=src/data/recalls.db
# Collector registry. Copy sources.example.json, fill URLs, then point here.
# PIPELINE_SOURCES_FILE=src/pipeline/sources.json
# PIPELINE_APPROVED_TABLE=recalls
# PIPELINE_REVIEW_TABLE=review_queue
# PIPELINE_USER_AGENT=Mozilla/5.0 (compatible; EDM-Dashboard/1.0; +https://everydosematters.org)
# PIPELINE_HTTP_TIMEOUT=30
# PIPELINE_EXTRACT_TIMEOUT=60
# PIPELINE_EXTRACT_MAX_CHARS=12000
# PIPELINE_EXTRACT_MAX_TOKENS=1024
# PIPELINE_REQUIRE_PRODUCT_NAME=true
# PIPELINE_REQUIRE_REASON=true
# PIPELINE_REQUIRE_PUBLISH_DATE=true
# PIPELINE_DATE_PATTERN=^\d{4}-\d{2}-\d{2}$
# PIPELINE_START_DATE=2020-01-01
# PIPELINE_USE_PREFECT=false
# PIPELINE_AUTO_APPROVE_VALID=true
# Optional extras for browser/scrapy/Prefect:
#   uv sync --extra pipeline && uv run playwright install
# If you turn Prefect on, also set DO_NOT_TRACK=1 to skip its telemetry noise.
